{
  "name": "paper-and-slate",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "tsx scripts/build-web.ts",
    "build:verify": "tsx scripts/build-boundary.ts",
    "docs:ingest": "tsx scripts/docs-ingest.ts",
    "docs:validate": "tsx scripts/docs-check.ts",
    "docs:bundle:check": "tsx scripts/docs-bundle-check.ts",
    "search:index": "tsx scripts/search-index.ts",
    "content:validate": "tsx scripts/content-check.ts",
    "feeds:check": "tsx scripts/feeds-check.ts",
    "release:check": "tsx scripts/release-check.ts",
    "routes:check": "tsx scripts/routes-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "security:check": "tsx scripts/security-check.ts",
    "license:check": "tsx scripts/license-check.ts",
    "seo:check": "tsx scripts/seo-check.ts",
    "performance:check": "tsx scripts/performance-check.ts",
    "rollback:check": "tsx scripts/rollback-check.ts",
    "workflow:check": "tsx scripts/workflow-check.ts",
    "requirements:check": "tsx scripts/requirements-report.ts",
    "control-plane:requirements:check": "tsx scripts/developer-control-plane-requirements.ts",
    "control-plane:architecture:check": "tsx scripts/developer-control-plane-architecture.ts",
    "control-plane:migrations:check": "tsx scripts/developer-control-plane-migrations.ts",
    "traceability:check": "pnpm requirements:check && tsx scripts/traceability-check.ts",
    "package:smoke": "tsx scripts/package-smoke.ts",
    "reproducibility:check": "tsx scripts/reproducibility-check.ts",
    "tower:evidence:import": "tsx scripts/tower-evidence-import.ts",
    "links": "playwright test tests/browser/links.spec.ts",
    "e2e": "playwright test tests/browser/smoke.spec.ts",
    "a11y": "playwright test tests/browser/a11y.spec.ts",
    "a11y:rc": "playwright test tests/browser/a11y-rc.spec.ts",
    "production:browser": "tsx scripts/production-browser-check.ts",
    "production:visual": "tsx scripts/production-visual-evidence.ts",
    "repository:evidence": "tsx scripts/repository-evidence.ts",
    "visual:update": "playwright test tests/browser/visual.spec.ts --update-snapshots",
    "visual:check": "playwright test tests/browser/visual.spec.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "lighthouse:staging": "tsx scripts/lighthouse-staging.ts",
    "staging:publication": "tsx scripts/staging-publication-check.ts",
    "container:check": "tsx scripts/container-check.ts",
    "wrappers:failure": "tsx scripts/wrapper-failure-fixture.ts",
    "sbom:generate": "tsx scripts/sbom.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "vulnerability:scan": "tsx scripts/vulnerability-scan.ts",
    "evidence:bundle": "tsx scripts/evidence-bundle.ts",
    "launch:report": "tsx scripts/launch-report.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:hosted": "tsx scripts/ci-browser.ts verify",
    "actions:check": "pnpm workflow:check",
    "packages:check": "pnpm package:smoke",
    "verify:release-reproducibility": "pnpm reproducibility:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.13.10",
    "eslint": "9.39.5",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "turbo": "2.9.14",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "3.2.6",
    "yaml": "2.9.0"
  }
}
