{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/projects/file-system",
        "http://127.0.0.1:3200/docs/paper-and-slate/next/concepts/provenance",
        "http://127.0.0.1:3200/news/local-publishing-foundations"
      ],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop", "disableStorageReset": true }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".generated/launch/lighthouse" }
  }
}
